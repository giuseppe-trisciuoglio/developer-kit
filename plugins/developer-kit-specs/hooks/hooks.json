{
  "description": "Developer Kit Specs hooks: Task lifecycle automation (auto-status, frontmatter validation)",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/task_lifecycle.py\" auto-status",
            "statusMessage": "Auto-updating task status..."
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/task_lifecycle.py\" validate",
            "statusMessage": "Validating task frontmatter..."
          }
        ]
      }
    ]
  }
}
